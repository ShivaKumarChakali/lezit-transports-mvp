// LEZIT Transport MVP — data model (PostgreSQL, Prisma)
// Phase 1: users, profiles, vehicles, documents.
// Phase 2: routes, schedules, bookings, trips, attendance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  lezit_admin
  vehicle_owner
  driver
  organization
  passenger
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum AccountStatus {
  active
  inactive
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  phone          String?
  role           Role
  approvalStatus ApprovalStatus @default(pending)
  status         AccountStatus  @default(active)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  ownerProfile     VehicleOwnerProfile?
  driverProfile    DriverProfile?
  orgProfile       OrganizationProfile?
  passengerProfile PassengerProfile?
  documents        Document[]
  vehicles         Vehicle[]            @relation("OwnerVehicles")
  schedulesAsDriver Schedule[]          @relation("ScheduleDriver")
  tripsAsDriver     Trip[]               @relation("TripDriver")
  bookingsAsPassenger Booking[]          @relation("BookingPassenger")
  attendanceAsPassenger Attendance[]     @relation("AttendancePassenger")

  @@map("users")
}

model VehicleOwnerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  gstNumber    String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vehicle_owner_profiles")
}

model DriverProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenceNumber String    @unique
  licenceExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("driver_profiles")
}

model OrganizationProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgName       String
  contactPerson String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("organization_profiles")
}

model PassengerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String?
  orgId      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("passenger_profiles")
}

model Vehicle {
  id                 String         @id @default(uuid())
  ownerId            String
  owner              User           @relation("OwnerVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  registrationNumber String         @unique
  make               String?
  model              String?
  year               Int?
  seatCapacity       Int?
  approvalStatus     ApprovalStatus @default(pending)
  status             AccountStatus  @default(active)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  schedules Schedule[]
  trips     Trip[]

  @@map("vehicles")
}

// Document uploads: metadata only in Phase 1. No file storage is wired up yet;
// fileUrl is a placeholder for the storage location once a provider is chosen.
model Document {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String?
  fileType     String?
  documentKind String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("documents")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum TripStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum AttendanceStatus {
  checked_in
  checked_out
  absent
}

model Route {
  id            String   @id @default(uuid())
  name          String
  startLocation String
  endLocation   String
  stops         String[] @default([])
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schedules Schedule[]
  bookings  Booking[]
  trips     Trip[]

  @@map("routes")
}

model Schedule {
  id            String   @id @default(uuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId      String?
  driver        User?    @relation("ScheduleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  departureTime String
  days          String[] @default([])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]
  trips    Trip[]

  @@map("schedules")
}

model Booking {
  id          String        @id @default(uuid())
  passengerId String
  passenger   User          @relation("BookingPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  routeId     String
  route       Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  seats       Int           @default(1)
  status      BookingStatus @default(confirmed)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendance Attendance[]

  @@map("bookings")
}

model Trip {
  id          String     @id @default(uuid())
  routeId     String
  route       Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  vehicleId   String?
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId    String?
  driver      User?      @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  date        DateTime
  status      TripStatus @default(scheduled)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  attendance Attendance[]

  @@map("trips")
}

model Attendance {
  id          String           @id @default(uuid())
  tripId      String
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  passengerId String
  passenger   User             @relation("AttendancePassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  status      AttendanceStatus @default(checked_in)
  checkInAt   DateTime         @default(now())
  checkOutAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tripId, passengerId])
  @@map("attendance")
}
